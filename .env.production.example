# Copy to .env.production on the VPS. Do not commit the real file.
CADDY_EMAIL=security@phoenixhandel.com

# Use a long, unique password. For example: openssl rand -base64 32
POSTGRES_PASSWORD=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public Vite configuration. The URL/key mirror the two values above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LOGO_DEV_PUBLISHABLE_KEY=

# Optional: enables the server-side support assistant. Never expose this key
# to the browser or commit it to Git.
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.6

# Optional: enables account contact-form delivery to the Phoenix inbox.
# Keep this Resend API key server-side only.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=Phoenix Support <security@phoenixhandel.com>
SUPPORT_INBOX_EMAIL=phoenixhandel@protonmail.com
